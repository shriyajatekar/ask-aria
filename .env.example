# Server-only (set in Vercel/host env; never NEXT_PUBLIC_*)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local dev (must match Google Cloud Console authorized redirect URI):
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback
# Production example (replace host; also register in Google Cloud Console):
# GOOGLE_REDIRECT_URI=https://your-domain.example/api/auth/google/callback
# Code fallback if unset: http://localhost:3001/api/auth/google/callback

# Encrypts OAuth state/pending + token cookies (use a long random value in production)
GOOGLE_SESSION_SECRET=
# Optional fallback if GOOGLE_SESSION_SECRET is unset:
AUTH_SECRET=

# NODE_ENV=production is set by the host (enables secure cookies).

# Client syncs signed-in user id to httpOnly ci-app-user-id via POST /api/auth/app-session
# so Google tokens are stored per user (demo-raghav, demo-yuga, demo-sri, etc.).
